    #[test]
    fun swap_crosses_tick_and_stops_at_limit() {
        let (mut scenario, mut p) = setup(3000);
        // Narrow position inside a wider one.
        let (mut pos_narrow, na, nb) = fund_position(
            &mut p,
            i32::neg_from(60).bits(),
            i32::from(60).bits(),
            2000000000,
            scenario.ctx(),
        );
        assert!(na == 5990710 && nb == 5990710);
        let (mut pos_wide, wa, wb) = fund_position(
            &mut p,
            i32::neg_from(600).bits(),
            i32::from(600).bits(),
            1000000000,
            scenario.ctx(),
        );
        assert!(wa == 29553011 && wb == 29553011);
        assert!(p.liquidity() == 3000000000);

        // Budget of 1e8 A, limited at tick -540: the swap crosses the
        // narrow position's lower bound at -60 (liquidity drops to the
        // wide position alone) and then fills to the limit, leaving
        // the rest of the budget unspent.
        let limit = tick_math::get_sqrt_price_at_tick(i32::neg_from(540));
        let (out_b, receipt) = p.swap_a_for_b(100000000, true, limit);
        let (owed, _) = pool::swap_receipt_amounts(&receipt);
        assert!(owed == 33475553); // partial fill
        assert!(out_b.value() == 32628153);
        p.repay_swap_a(receipt, balance::create_for_testing<COIN_A>(owed));

        assert!(p.sqrt_price_x64() == limit);
        assert!(i32::eq(p.tick_current(), i32::neg_from(540)));
        assert!(p.liquidity() == 1000000000);

        // Fee attribution across the crossing, exact per reference:
        // the narrow position earned while in range, the wide one
        // throughout.
        let (f1a, f1b) = p.collect_fees(&mut pos_narrow);
        assert!(f1a.value() == 18080 && f1b.value() == 0);
        let (f2a, f2b) = p.collect_fees(&mut pos_wide);
        assert!(f2a.value() == 82347 && f2b.value() == 0);

        balance::destroy_for_testing(f1a);
        balance::destroy_for_testing(f1b);
        balance::destroy_for_testing(f2a);
        balance::destroy_for_testing(f2b);
        balance::destroy_for_testing(out_b);
        transfer::public_transfer(pos_narrow, ADMIN);
        transfer::public_transfer(pos_wide, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    #[test]
    fun protocol_fee_is_carved_from_input() {
        let (mut scenario, mut p) = setup(3000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());

        scenario.next_tx(ADMIN);
        let cap = scenario.take_from_sender<ProtocolCap>();
        p.set_protocol_fee(&cap, 1000, 0); // 0.1% on A-to-B only

        let (out_b, receipt) = p.swap_a_for_b(
            1000000000,
            true,
            tick_math::min_sqrt_price() + 1,
        );
        let (owed, protocol_cut) = pool::swap_receipt_amounts(&receipt);
        assert!(owed == 1000000000);
        assert!(protocol_cut == 1000000); // exactly 0.1% of the input
        assert!(out_b.value() == 995011965);
        p.repay_swap_a(receipt, balance::create_for_testing<COIN_A>(owed));

        assert!(p.sqrt_price_x64() == 18428389342639115030);
        let (acc_a, acc_b) = p.protocol_fees_accrued();
        assert!(acc_a == 1000000 && acc_b == 0);

        let (got_a, got_b) = p.collect_protocol_fees(&cap);
        assert!(got_a.value() == 1000000 && got_b.value() == 0);
        let (acc_a2, _) = p.protocol_fees_accrued();
        assert!(acc_a2 == 0);

        balance::destroy_for_testing(got_a);
        balance::destroy_for_testing(got_b);
        balance::destroy_for_testing(out_b);
        scenario.return_to_sender(cap);
        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    // === Liquidity round trips ===

    #[test]
    fun remove_liquidity_and_close_position() {
        let (mut scenario, mut p) = setup(3000);
        let (mut pos, need_a, need_b) = fund_position(
            &mut p,
            i32::neg_from(FULL_LOWER).bits(),
            i32::from(FULL_UPPER).bits(),
            L_BIG,
            scenario.ctx(),
        );

        let (got_a, got_b) = p.remove_liquidity(&mut pos, L_BIG);
        // Round-down on exit: at most one unit less per token than
        // paid in; the difference stays in the pool.
        assert!(need_a - got_a.value() <= 1);
        assert!(need_b - got_b.value() <= 1);
        assert!(pos.liquidity() == 0);
        assert!(p.liquidity() == 0);

        // No fees were earned; the emptied position closes cleanly.
        let (fee_a, fee_b) = p.collect_fees(&mut pos);
        assert!(fee_a.value() == 0 && fee_b.value() == 0);
        balance::destroy_for_testing(fee_a);
        balance::destroy_for_testing(fee_b);
        pos.close();

        balance::destroy_for_testing(got_a);
        balance::destroy_for_testing(got_b);
        ts::return_shared(p);
        scenario.end();
    }

    #[test]
    fun partial_remove_keeps_position_alive() {
        let (mut scenario, mut p) = setup(3000);
        let mut pos = full_range(&mut p, L_BIG, scenario.ctx());

        let (got_a, got_b) = p.remove_liquidity(&mut pos, L_BIG / 4);
        assert!(pos.liquidity() == L_BIG - L_BIG / 4);
        assert!(p.liquidity() == L_BIG - L_BIG / 4);
        assert!(got_a.value() > 0 && got_b.value() > 0);

        balance::destroy_for_testing(got_a);
        balance::destroy_for_testing(got_b);
        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    // === Donations ===

    #[test]
    fun donate_accrues_to_in_range_positions() {
        let (mut scenario, mut p) = setup(3000);
        let mut pos = full_range(&mut p, L_BIG, scenario.ctx());

        p.donate(
            balance::create_for_testing<COIN_A>(1000000),
            balance::create_for_testing<COIN_B>(2000000),
        );

        let (fee_a, fee_b) = p.collect_fees(&mut pos);
        // Sole LP receives the donation minus floor rounding.
        assert!(fee_a.value() >= 999999 && fee_a.value() <= 1000000);
        assert!(fee_b.value() >= 1999999 && fee_b.value() <= 2000000);

        balance::destroy_for_testing(fee_a);
        balance::destroy_for_testing(fee_b);
        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    // === Flash loans ===

    #[test]
    fun flash_loan_and_repay() {
        let (mut scenario, mut p) = setup(3000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());
        let (ra0, rb0) = p.reserves();

        let (loan_a, loan_b, receipt) = p.flash_loan(500000000, 300000000);
        assert!(loan_a.value() == 500000000 && loan_b.value() == 300000000);
        let (ra1, rb1) = p.reserves();
        assert!(ra1 == ra0 - 500000000 && rb1 == rb0 - 300000000);

        p.repay_flash_loan(receipt, loan_a, loan_b);
        let (ra2, rb2) = p.reserves();
        assert!(ra2 == ra0 && rb2 == rb0);

        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    // === Failure paths ===

    #[test]
    #[expected_failure(abort_code = haneul_amm::pool::ESwapAmountZero)]
    fun swap_zero_amount_aborts() {
        let (mut scenario, mut p) = setup(3000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());
        transfer::public_transfer(pos, ADMIN);
        let (out, receipt) = p.swap_a_for_b(0, true, tick_math::min_sqrt_price() + 1);
        balance::destroy_for_testing(out);
        p.repay_swap_a(receipt, balance::zero());
        abort 0
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::pool::EPriceLimitAlreadyExceeded)]
    fun limit_on_wrong_side_aborts() {
        let (mut scenario, mut p) = setup(3000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());
        transfer::public_transfer(pos, ADMIN);
        // A-to-B pushes the price down; a limit above the current
        // price is on the wrong side.
        let (out, receipt) = p.swap_a_for_b(1000, true, PRICE_1 + 1);
        balance::destroy_for_testing(out);
        p.repay_swap_a(receipt, balance::zero());
        abort 0
    }

