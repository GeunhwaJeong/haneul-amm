        scenario.next_tx(ADMIN);
        let mut p2 = scenario.take_shared<Pool<COIN_A, COIN_B>>();

        let (out, receipt) = p.swap_a_for_b(
            1000000,
            true,
            tick_math::min_sqrt_price() + 1,
