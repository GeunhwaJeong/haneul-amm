    #[test]
    #[expected_failure(abort_code = haneul_amm::tick::ETickMisaligned)]
    fun misaligned_position_ticks_abort() {
        let (mut scenario, p) = setup(3000);
        let pos = p.open_position(
            i32::neg_from(61).bits(),
            i32::from(60).bits(),
            scenario.ctx(),
        );
        transfer::public_transfer(pos, ADMIN);
        abort 0
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::pool::ENoLiquidityToReceiveFees)]
    fun donating_to_empty_pool_aborts() {
        let (_scenario, mut p) = setup(3000);
        p.donate(
            balance::create_for_testing<COIN_A>(1),
            balance::create_for_testing<COIN_B>(0),
        );
        abort 0
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::pool::EInvalidFeeForExactOut)]
    fun exact_out_with_full_fee_aborts() {
        // A 100% fee pool is legal, but exact-output swaps on it are
        // not: the entire input would be consumed as fee.
        let (mut scenario, mut p) = setup(1000000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());
        transfer::public_transfer(pos, ADMIN);
        let (out, receipt) = p.swap_a_for_b(
            1000,
            false,
            tick_math::min_sqrt_price() + 1,
        );
        balance::destroy_for_testing(out);
        p.repay_swap_a(receipt, balance::zero());
        abort 0
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::position::EPositionNotEmpty)]
    fun closing_position_with_liquidity_aborts() {
        let (mut scenario, mut p) = setup(3000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());
        ts::return_shared(p);
        scenario.end();
        pos.close();
    }
}
