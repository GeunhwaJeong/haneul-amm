/// Pool integration tests. All exact numeric expectations were
/// generated by an independent big-integer reference implementation of
/// the same engine, so these tests pin the full swap pipeline
/// (bitmap walk, step math, fee split, tick crossing) bit-for-bit.
module haneul_amm::pool_tests {
    use haneul::balance;
    use haneul::test_scenario as ts;
    use haneul_amm::haneul_amm as amm_init;
    use haneul_amm::i32;
    use haneul_amm::pool::{Self, Pool, ProtocolCap};
    use haneul_amm::position::Position;
    use haneul_amm::registry::{Self, Registry};
    use haneul_amm::test_coins::{COIN_A, COIN_B};
    use haneul_amm::tick_math;

    const ADMIN: address = @0xAD;
    const PRICE_1: u128 = 1 << 64;
    const L_BIG: u128 = 1000000000000; // 1e12

    // Full usable range for tick spacing 60.
    const FULL_LOWER: u32 = 443580;
    const FULL_UPPER: u32 = 443580;

    fun setup(fee_pips: u64): (ts::Scenario, Pool<COIN_A, COIN_B>) {
        let mut scenario = ts::begin(ADMIN);
        amm_init::init_for_testing(scenario.ctx());
        scenario.next_tx(ADMIN);
        let mut reg = scenario.take_shared<Registry>();
        ensure_tier(&mut reg, &scenario, fee_pips, 60);
        registry::create_pool<COIN_A, COIN_B>(&mut reg, fee_pips, 60, PRICE_1, scenario.ctx());
        ts::return_shared(reg);
        scenario.next_tx(ADMIN);
        let p = scenario.take_shared<Pool<COIN_A, COIN_B>>();
        (scenario, p)
    }

    /// Enable a (fee, spacing) tier with the admin's capability if the
    /// registry does not already have it. The suite exercises tiers
    /// beyond the defaults (0.05% and 1% at spacing 60, a 100% fee).
    fun ensure_tier(reg: &mut Registry, scenario: &ts::Scenario, fee_pips: u64, spacing: u32) {
        if (!reg.is_fee_tier_enabled(fee_pips, spacing)) {
            let cap = scenario.take_from_sender<ProtocolCap>();
            reg.enable_fee_tier(&cap, fee_pips, spacing);
            scenario.return_to_sender(cap);
        };
    }

    /// Open a position and fund it, asserting the exact principal.
    fun fund_position(
        p: &mut Pool<COIN_A, COIN_B>,
        lower_bits: u32,
        upper_bits: u32,
        liquidity: u128,
        ctx: &mut TxContext,
    ): (Position, u64, u64) {
        let mut pos = p.open_position(lower_bits, upper_bits, ctx);
        let receipt = p.add_liquidity(&mut pos, liquidity);
        let (need_a, need_b) = pool::add_liquidity_receipt_amounts(&receipt);
        p.repay_add_liquidity(
            receipt,
            balance::create_for_testing<COIN_A>(need_a),
            balance::create_for_testing<COIN_B>(need_b),
        );
        (pos, need_a, need_b)
    }

    fun full_range(
        p: &mut Pool<COIN_A, COIN_B>,
        liquidity: u128,
        ctx: &mut TxContext,
    ): Position {
        let (pos, _, _) =
            fund_position(
                p,
                i32::neg_from(FULL_LOWER).bits(),
                i32::from(FULL_UPPER).bits(),
                liquidity,
                ctx,
            );
        pos
    }

    // === Creation and funding ===

    #[test]
    fun pool_initial_state() {
        let (scenario, p) = setup(3000);
        assert!(p.sqrt_price_x64() == PRICE_1);
        assert!(i32::eq(p.tick_current(), i32::zero()));
        assert!(p.liquidity() == 0);
        assert!(p.lp_fee_pips() == 3000);
        assert!(!p.is_dynamic_fee());
        assert!(p.tick_spacing() == 60);
        assert!(p.hook().is_none());
        let (ra, rb) = p.reserves();
        assert!(ra == 0 && rb == 0);
        ts::return_shared(p);
        scenario.end();
    }

    #[test]
    fun add_liquidity_full_range_exact_amounts() {
        let (mut scenario, mut p) = setup(3000);
        let (pos, need_a, need_b) = fund_position(
            &mut p,
            i32::neg_from(FULL_LOWER).bits(),
            i32::from(FULL_UPPER).bits(),
            L_BIG,
            scenario.ctx(),
        );
        // Reference: symmetric range around price 1.0.
        assert!(need_a == 999999999767);
        assert!(need_b == 999999999767);
        assert!(p.liquidity() == L_BIG);
        let (ra, rb) = p.reserves();
        assert!(ra == need_a && rb == need_b);
        assert!(pos.liquidity() == L_BIG);

        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    #[test]
    fun add_liquidity_one_sided_ranges() {
        let (mut scenario, mut p) = setup(3000);
        // Entirely above the current price: token A only.
        let (pos_hi, need_a, need_b) = fund_position(
            &mut p,
            i32::from(60).bits(),
            i32::from(120).bits(),
            L_BIG,
            scenario.ctx(),
        );
        assert!(need_a > 0 && need_b == 0);
        // Entirely below: token B only.
        let (pos_lo, need_a2, need_b2) = fund_position(
            &mut p,
            i32::neg_from(120).bits(),
            i32::neg_from(60).bits(),
            L_BIG,
            scenario.ctx(),
        );
        assert!(need_a2 == 0 && need_b2 > 0);
        // Neither range is active at the current price.
        assert!(p.liquidity() == 0);

        transfer::public_transfer(pos_hi, ADMIN);
        transfer::public_transfer(pos_lo, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    // === Swaps (reference-pinned) ===

    #[test]
    fun swap_a_for_b_exact_in() {
        let (mut scenario, mut p) = setup(3000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());

        let (out_b, receipt) = p.swap_a_for_b(
            1000000000,
            true,
            tick_math::min_sqrt_price() + 1,
        );
        let (owed, protocol_cut) = pool::swap_receipt_amounts(&receipt);
        assert!(owed == 1000000000);
        assert!(protocol_cut == 0);
        assert!(out_b.value() == 996006981);
        p.repay_swap_a(receipt, balance::create_for_testing<COIN_A>(owed));

        assert!(p.sqrt_price_x64() == 18428370987834680440);
        assert!(i32::eq(p.tick_current(), i32::neg_from(20)));
        assert!(p.liquidity() == L_BIG);
        let (fg_a, fg_b) = p.fee_growth_globals();
        assert!(fg_a == 55340232221128);
        assert!(fg_b == 0);
        // Reserves: funding + input - output.
        let (ra, rb) = p.reserves();
        assert!(ra == 999999999767 + 1000000000);
        assert!(rb == 999999999767 - 996006981);

        balance::destroy_for_testing(out_b);
        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    #[test]
    fun collect_fees_after_swap_exact() {
        let (mut scenario, mut p) = setup(3000);
        let mut pos = full_range(&mut p, L_BIG, scenario.ctx());

        let (out_b, receipt) = p.swap_a_for_b(
            1000000000,
            true,
            tick_math::min_sqrt_price() + 1,
        );
        let (owed, _) = pool::swap_receipt_amounts(&receipt);
        p.repay_swap_a(receipt, balance::create_for_testing<COIN_A>(owed));
        balance::destroy_for_testing(out_b);

        // Sole LP earns the whole 0.3% fee minus one unit of floor
        // rounding: 2_999_999 of the 3_000_000 charged.
        let (fee_a, fee_b) = p.collect_fees(&mut pos);
        assert!(fee_a.value() == 2999999);
        assert!(fee_b.value() == 0);
        balance::destroy_for_testing(fee_a);
        balance::destroy_for_testing(fee_b);

        // Nothing left to collect immediately after.
        let (fee_a2, fee_b2) = p.collect_fees(&mut pos);
        assert!(fee_a2.value() == 0 && fee_b2.value() == 0);
        balance::destroy_for_testing(fee_a2);
        balance::destroy_for_testing(fee_b2);

        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

    #[test]
    fun swap_b_for_a_exact_out_after_first_swap() {
        let (mut scenario, mut p) = setup(3000);
        let pos = full_range(&mut p, L_BIG, scenario.ctx());

        let (out_b, r1) = p.swap_a_for_b(1000000000, true, tick_math::min_sqrt_price() + 1);
        let (owed1, _) = pool::swap_receipt_amounts(&r1);
        p.repay_swap_a(r1, balance::create_for_testing<COIN_A>(owed1));
        balance::destroy_for_testing(out_b);

        // Ask for exactly 5e8 of A back.
        let (out_a, r2) = p.swap_b_for_a(500000000, false, tick_math::max_sqrt_price() - 1);
        let (owed2, _) = pool::swap_receipt_amounts(&r2);
        assert!(out_a.value() == 500000000);
        assert!(owed2 == 500756137);
        p.repay_swap_b(r2, balance::create_for_testing<COIN_B>(owed2));

        assert!(p.sqrt_price_x64() == 18437580596153263445);
        assert!(i32::eq(p.tick_current(), i32::neg_from(10)));

        balance::destroy_for_testing(out_a);
        transfer::public_transfer(pos, ADMIN);
        ts::return_shared(p);
        scenario.end();
    }

