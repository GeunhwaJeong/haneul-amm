/// Vectors here were generated by an independent big-integer reference
/// implementation of the same fixed-point algorithm, so the Move code
/// is checked bit-for-bit, not approximately.
module haneul_amm::tick_math_tests {
    use haneul_amm::i32;
    use haneul_amm::tick_math;

    fun tick(t: u32, neg: bool): haneul_amm::i32::I32 {
        if (neg) i32::neg_from(t) else i32::from(t)
    }

    #[test]
    fun sqrt_price_at_zero_is_one() {
        assert!(tick_math::get_sqrt_price_at_tick(i32::zero()) == 1 << 64);
    }

    #[test]
    fun sqrt_price_known_vectors() {
        assert!(tick_math::get_sqrt_price_at_tick(tick(1, false)) == 18447666387855959851);
        assert!(tick_math::get_sqrt_price_at_tick(tick(1, true)) == 18445821805675392312);
        assert!(tick_math::get_sqrt_price_at_tick(tick(2, false)) == 18448588748116922572);
        assert!(tick_math::get_sqrt_price_at_tick(tick(2, true)) == 18444899583751176499);
        assert!(tick_math::get_sqrt_price_at_tick(tick(10, false)) == 18455969290605290428);
        assert!(tick_math::get_sqrt_price_at_tick(tick(10, true)) == 18437523468038800959);
        assert!(tick_math::get_sqrt_price_at_tick(tick(100, false)) == 18539204128674405813);
        assert!(tick_math::get_sqrt_price_at_tick(tick(100, true)) == 18354745142194483564);
        assert!(tick_math::get_sqrt_price_at_tick(tick(1000, false)) == 19392480388906836278);
        assert!(tick_math::get_sqrt_price_at_tick(tick(1000, true)) == 17547129613991598782);
        assert!(tick_math::get_sqrt_price_at_tick(tick(12345, false)) == 34195943348800206621);
        assert!(tick_math::get_sqrt_price_at_tick(tick(12345, true)) == 9950957148631419639);
        assert!(tick_math::get_sqrt_price_at_tick(tick(100000, false)) == 2737055259406582257881);
        assert!(tick_math::get_sqrt_price_at_tick(tick(100000, true)) == 124324258982887575);
        assert!(
            tick_math::get_sqrt_price_at_tick(tick(443635, false)) == 79222712478800779441888593671,
        );
        assert!(tick_math::get_sqrt_price_at_tick(tick(443635, true)) == 4295262764);
    }

    #[test]
    fun sqrt_price_at_bounds_matches_constants() {
        assert!(
            tick_math::get_sqrt_price_at_tick(tick_math::min_tick())
                == tick_math::min_sqrt_price(),
        );
        assert!(
            tick_math::get_sqrt_price_at_tick(tick_math::max_tick())
                == tick_math::max_sqrt_price(),
        );
        assert!(tick_math::min_sqrt_price() == 4295048017);
        assert!(tick_math::max_sqrt_price() == 79226673515401279992447579062);
    }

    #[test]
    fun tick_at_sqrt_price_known_vectors() {
        assert!(i32::eq(tick_math::get_tick_at_sqrt_price(1 << 64), i32::zero()));
        assert!(i32::eq(tick_math::get_tick_at_sqrt_price((1 << 64) + 1), i32::zero()));
        assert!(
            i32::eq(tick_math::get_tick_at_sqrt_price(27670116110564327424), i32::from(8109)),
        );
        assert!(
            i32::eq(tick_math::get_tick_at_sqrt_price(36893488147419103232), i32::from(13863)),
        );
        assert!(
            i32::eq(tick_math::get_tick_at_sqrt_price(184467440737095516160), i32::from(46054)),
        );
        assert!(
            i32::eq(
                tick_math::get_tick_at_sqrt_price(6148914691236517205),
                i32::neg_from(21974),
            ),
        );
        assert!(
            i32::eq(tick_math::get_tick_at_sqrt_price(4295060362), i32::neg_from(443636)),
        );
        assert!(
            i32::eq(
                tick_math::get_tick_at_sqrt_price(79226673515401279992447578063),
                i32::from(443635),
            ),
        );
    }

    #[test]
    fun tick_at_boundary_prices() {
        assert!(
            i32::eq(
                tick_math::get_tick_at_sqrt_price(tick_math::min_sqrt_price()),
                tick_math::min_tick(),
            ),
        );
        assert!(
            i32::eq(
                tick_math::get_tick_at_sqrt_price(tick_math::max_sqrt_price() - 1),
                i32::from(443635),
            ),
        );
    }

    #[test]
    fun round_trip_sample_sweep() {
        // Every 8191 ticks across the whole range, both signs.
        let mut t: u32 = 0;
        while (t <= 443636) {
            let pos = tick(t, false);
            let neg = tick(t, true);
            assert!(
                i32::eq(tick_math::get_tick_at_sqrt_price(
                    tick_math::get_sqrt_price_at_tick(pos),
                ), pos),
            );
            assert!(
                i32::eq(tick_math::get_tick_at_sqrt_price(
                    tick_math::get_sqrt_price_at_tick(neg),
                ), neg),
            );
            t = t + 8191;
        };
    }

    #[test]
    fun sqrt_price_is_strictly_monotone_near_zero() {
        let mut prev = tick_math::get_sqrt_price_at_tick(tick(50, true));
        let mut t: u32 = 49;
        while (t > 0) {
            let p = tick_math::get_sqrt_price_at_tick(tick(t, true));
            assert!(p > prev);
            prev = p;
            t = t - 1;
        };
        let mut t: u32 = 0;
        while (t <= 50) {
            let p = tick_math::get_sqrt_price_at_tick(tick(t, false));
            assert!(p > prev || (t == 0 && p == prev));
            if (t == 0) assert!(p == 1 << 64);
            prev = p;
            t = t + 1;
        };
    }

    #[test]
    fun usable_tick_bounds_respect_spacing() {
        assert!(i32::eq(tick_math::max_usable_tick(60), i32::from(443580)));
        assert!(i32::eq(tick_math::min_usable_tick(60), i32::neg_from(443580)));
        assert!(i32::eq(tick_math::max_usable_tick(1), tick_math::max_tick()));
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::tick_math::EInvalidTick)]
    fun tick_above_max_aborts() {
        tick_math::get_sqrt_price_at_tick(i32::from(443637));
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::tick_math::EInvalidTick)]
    fun tick_below_min_aborts() {
        tick_math::get_sqrt_price_at_tick(i32::neg_from(443637));
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::tick_math::EInvalidSqrtPrice)]
    fun price_below_min_aborts() {
        tick_math::get_tick_at_sqrt_price(tick_math::min_sqrt_price() - 1);
    }

    #[test]
    #[expected_failure(abort_code = haneul_amm::tick_math::EInvalidSqrtPrice)]
    fun price_at_max_aborts() {
        tick_math::get_tick_at_sqrt_price(tick_math::max_sqrt_price());
    }
}
